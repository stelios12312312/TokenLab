{
  "schema_version": 1,
  "minimum_per_type": 11,
  "target_per_type": 20,
  "command": "node .agent/skills/quant-researcher/tests/test_quant_researcher_e2e.mjs --type <project-type> --min 11",
  "constraints": {
    "no_live_data": true,
    "network_calls": false,
    "external_service_calls": false,
    "trading_or_betting": false,
    "promotion_allowed_default": false
  },
  "required_lifecycle": [
    "SURVEY",
    "HYPOTHESIZE",
    "DESIGN",
    "planner-loop",
    "INTERPRET",
    "ROUTE",
    "REPORT",
    "CLOSE"
  ],
  "required_mix_per_type": {
    "golden": 2,
    "killed-hypothesis": 2,
    "defer-blocked-data": 2,
    "planted-quant-failure": 3,
    "stale-or-unrouted": 1,
    "smoke-kill-attempt": 1
  },
