{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planner.scientific_evidence_artifact.v1",
  "title": "Typed scientific evidence artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "identity", "payload"],
  "properties": {
    "schema_version": { "const": "planner.scientific_evidence_artifact.v1" },
    "artifact_type": { "enum": ["preregistration", "executed_config", "universe", "folds", "trials", "observations", "result", "registry", "ticket", "plan_identity"] },
    "identity": { "$ref": "#/$defs/identity" },
    "payload": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "artifact_type": { "const": "preregistration" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/preregistration" } } } },
    { "if": { "properties": { "artifact_type": { "const": "executed_config" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/executed_config" } } } },
    { "if": { "properties": { "artifact_type": { "const": "universe" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/universe" } } } },
    { "if": { "properties": { "artifact_type": { "const": "folds" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/folds" } } } },
    { "if": { "properties": { "artifact_type": { "const": "trials" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/trials" } } } },
    { "if": { "properties": { "artifact_type": { "const": "observations" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/observations" } } } },
    { "if": { "properties": { "artifact_type": { "const": "result" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/result" } } } },
    { "if": { "properties": { "artifact_type": { "enum": ["registry", "ticket", "plan_identity"] } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/named_record" } } } }
  ],
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["experiment_id", "title", "hypothesis_id", "ticket_id", "story_id", "plan_id"],
      "properties": {
        "experiment_id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
        "hypothesis_id": { "type": "string", "minLength": 1 }, "ticket_id": { "type": "string", "minLength": 1 },
        "story_id": { "type": "string", "minLength": 1 }, "plan_id": { "type": "string", "minLength": 1 }
      }
    },
    "window": {
      "type": "object", "additionalProperties": false, "required": ["role", "start", "end"],
      "properties": { "role": { "type": "string", "minLength": 1 }, "start": { "type": "string", "format": "date" }, "end": { "type": "string", "format": "date" } }
    },
    "scalar_parameter": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "choice": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension", "value", "mechanism", "prior", "alternatives", "basis", "sensitivity"],
      "properties": {
        "dimension": { "enum": ["windows", "frequency", "universe", "strategy_families", "parameter_ranges", "weights", "thresholds", "trials", "folds"] },
        "value": { "$ref": "#/$defs/scalar_parameter" }, "mechanism": { "type": "string", "minLength": 1 }, "prior": { "type": "string", "minLength": 1 },
        "alternatives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scalar_parameter" } }, "basis": { "type": "string", "minLength": 1 }, "rationale": { "type": "string" },
        "sensitivity": { "type": "object", "additionalProperties": false, "required": ["description", "outcomes"], "properties": { "description": { "type": "string", "minLength": 1 }, "outcomes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scalar_parameter" } } } }
      }
    },
    "preregistration": {
      "type": "object", "additionalProperties": false, "required": ["windows", "purge_days", "parameter_choices"],
      "properties": { "windows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/window" } }, "purge_days": { "type": "integer", "minimum": 0 }, "parameter_choices": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/choice" } } }
    },
    "executed_config": {
      "type": "object", "additionalProperties": false, "required": ["windows", "selected_parameters", "folds_requested", "trials_requested", "universe_target_count"],
      "properties": { "windows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/window" } }, "selected_parameters": { "$ref": "#/$defs/selected_parameters" }, "folds_requested": { "type": "integer", "minimum": 1 }, "trials_requested": { "type": "integer", "minimum": 1 }, "universe_target_count": { "type": "integer", "minimum": 1 } }
    },
    "selected_parameters": {
      "type": "object", "additionalProperties": false,
      "required": ["windows", "frequency", "universe", "strategy_families", "parameter_ranges", "weights", "thresholds", "trials", "folds"],
      "properties": { "windows": { "$ref": "#/$defs/scalar_parameter" }, "frequency": { "$ref": "#/$defs/scalar_parameter" }, "universe": { "$ref": "#/$defs/scalar_parameter" }, "strategy_families": { "$ref": "#/$defs/scalar_parameter" }, "parameter_ranges": { "$ref": "#/$defs/scalar_parameter" }, "weights": { "$ref": "#/$defs/scalar_parameter" }, "thresholds": { "$ref": "#/$defs/scalar_parameter" }, "trials": { "$ref": "#/$defs/scalar_parameter" }, "folds": { "$ref": "#/$defs/scalar_parameter" } }
    },
    "universe": {
      "type": "object", "additionalProperties": false, "required": ["as_of", "ranking_method", "assets", "survivorship_policy", "sensitivity"],
      "properties": { "as_of": { "type": "string", "format": "date" }, "ranking_method": { "type": "string", "minLength": 1 }, "survivorship_policy": { "type": "string", "minLength": 1 }, "sensitivity": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "assets": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["asset_id", "rank", "eligible"], "properties": { "asset_id": { "type": "string", "minLength": 1 }, "rank": { "type": "integer", "minimum": 1 }, "eligible": { "type": "boolean" }, "exclusion_reason": { "type": "string" } } } } }
    },
    "folds": { "type": "object", "additionalProperties": false, "required": ["records"], "properties": { "records": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["fold_id", "status", "usable"], "properties": { "fold_id": { "type": "string", "minLength": 1 }, "status": { "enum": ["complete", "failed", "not_run"] }, "usable": { "type": "boolean" } } } } } },
    "trials": { "type": "object", "additionalProperties": false, "required": ["records"], "properties": { "records": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["trial_id", "status", "parameter_set"], "properties": { "trial_id": { "type": "string", "minLength": 1 }, "status": { "enum": ["complete", "failed", "not_run"] }, "parameter_set": { "type": "object", "minProperties": 1, "propertyNames": { "type": "string", "minLength": 1 }, "additionalProperties": { "$ref": "#/$defs/scalar_parameter" } } } } } } },
    "observations": { "type": "object", "additionalProperties": false, "required": ["records"], "properties": { "records": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["observation_id", "asset_id", "period_id", "event_id", "eligible"], "properties": { "observation_id": { "type": "string", "minLength": 1 }, "asset_id": { "type": "string", "minLength": 1 }, "period_id": { "type": "string", "minLength": 1 }, "event_id": { "type": "string", "minLength": 1 }, "eligible": { "type": "boolean" }, "exclusion_reason": { "type": "string" } } } } } },
    "counterargument": { "type": "object", "additionalProperties": false, "required": ["type", "assessment", "status"], "properties": { "type": { "enum": ["temporal_leakage", "dependence_power", "parameter_arbitrariness", "universe_bias", "provenance_integrity", "identity_consistency"] }, "assessment": { "type": "string", "minLength": 1 }, "status": { "enum": ["addressed", "material_gap"] } } },
    "result": { "type": "object", "additionalProperties": false, "required": ["execution_status", "outcome", "counterarguments"], "properties": { "execution_status": { "enum": ["not_run", "complete", "failed"] }, "outcome": { "enum": ["positive", "negative", "mixed"] }, "counterarguments": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/counterargument" } } } },
    "named_record": { "type": "object", "additionalProperties": false, "required": ["status", "source"], "properties": { "status": { "type": "string", "minLength": 1 }, "source": { "type": "string", "minLength": 1 } } }
  }
}
