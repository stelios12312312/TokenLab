  "receipt_path": ".agent/skills/iterative-planner/config/last_upgrade_receipt.json",
  "journal_git_path": "iterative-planner/managed-upgrade",
  "candidate_scopes": [
    ".agent/skills/iterative-planner",
    ".agent/rules.md",
    ".agent/rules",
    ".agent/scripts",
    ".agent/workflows",
    "CLAUDE.md",
    "GEMINI.md",
    "AGENTS.md",
    ".cursor/rules/iterative-planner.mdc",
