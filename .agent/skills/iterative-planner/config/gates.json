{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "Gate registry — single source of truth for all transition gates. Scripts read from here instead of hardcoding gate names.",
  "guide_first_contract": {
    "attempted_gate_preparation": "required_before_evaluation",
    "hard_block_classes": [
      "semantic_incorrectness",
      "proof_integrity",
      "irreversible_or_shared_surface_damage"
    ],
    "advisory_policy": "visible_and_persisted",
    "uncoded_fail_policy": "contract_defect",
    "terminal_verdict_source": "transition_receipt"
  },
  "evaluation_sessions": {
    "enabled": true,
    "freshness_ms": 120000,
    "retention_count": 8,
    "disable_environment_flag": "PLANNER_DISABLE_GATE_REUSE",
    "unknown_input_policy": "run"
  },
  "check_families": {
    "health": {
      "cacheable": true,
      "inputs": ["head", "index", "unstaged", "untracked", "health_config"],
      "applicability": "configured_health_scan_or_final_proof_boundary",
      "unknown_input_policy": "run"
    },
    "test_baseline": {
      "cacheable": true,
      "inputs": ["code", "tests", "evidence"],
      "applicability": "code_or_test_change",
      "unknown_input_policy": "run"
    },
    "reachability": {
      "cacheable": true,
      "inputs": ["gate_registry", "prolog", "rules", "checklists", "workflows"],
      "applicability": "topology_boundary",
      "unknown_input_policy": "run"
    },
    "persona": {
      "cacheable": true,
      "inputs": ["goal", "focus", "planned_files", "changed_files", "persona_config", "persona_artifacts"],
      "applicability": "persona_audit_enabled",
      "unknown_input_policy": "run"
    },
    "semantic": {
      "cacheable": false,
      "inputs": ["state", "plan", "evidence", "story_registry", "ontology", "rules"],
      "applicability": "semantic_phase_boundary",
      "unknown_input_policy": "run"
    },
    "notify_handoff": {
      "cacheable": true,
      "inputs": ["close_receipt", "summary", "notification", "knowledge_handoff"],
      "applicability": "notify_user_only",
      "unknown_input_policy": "run"
    }
  },
  "performance_budgets": {
    "default_no_plan_status_p95_ms": 1500,
    "unchanged_actual_p95_ms": 2000,
    "unchanged_actual_max_dry_run_ratio": 0.25,
    "fresh_notify_max_close_ratio": 0.25,
    "compact_artifact_max_legacy_ratio": 0.35
  },
  "gates": {
    "explore-to-plan": {
      "from": "explore",
      "to": "plan",
      "authority_profile": {
        "phase": "plan",
        "agent_role": "primary",
        "persona_role": "challenge",
        "ontology_role": "contract_enforcement",
        "continuous_execute_supervision": false
      },
      "persona_audit": true,
      "health_scan": "quick",
      "trace_audit": true,
      "reachability_audit": true,
      "failure_code_prefix": "GATE-EXP"
    },
    "plan-to-execute": {
      "from": "plan",
      "to": "execute",
      "authority_profile": {
        "phase": "execute",
        "agent_role": "primary",
        "persona_role": "boundary_only",
        "ontology_role": "boundary_verification",
        "continuous_execute_supervision": false
      },
      "persona_audit": true,
      "health_scan": null,
      "trace_audit": true,
      "reachability_audit": true,
      "pre_mortem": true,
      "pre_mortem_min_risks": 3,
      "failure_code_prefix": "GATE-PLN"
    },
    "execute-to-reflect": {
      "from": "execute",
      "to": "reflect",
      "authority_profile": {
        "phase": "reflect",
        "agent_role": "primary",
        "persona_role": "challenge",
        "ontology_role": "contract_enforcement",
        "continuous_execute_supervision": false
      },
      "persona_audit": true,
      "health_scan": null,
      "trace_audit": true,
      "reachability_audit": true,
      "hardline_audit": true,
      "hardline_personas": ["wiring_auditor", "assumptions_challenger", "config_integrity", "traceability", "tokenomics"],
      "failure_code_prefix": "GATE-ETR"
    },
    "reflect-to-validate": {
      "from": "reflect",
      "to": "validate",
      "authority_profile": {
        "phase": "validate",
        "agent_role": "primary",
        "persona_role": "proof_challenge",
        "ontology_role": "proof_consistency",
        "continuous_execute_supervision": false
      },
      "persona_audit": true,
      "health_scan": "full",
      "trace_audit": true,
      "reachability_audit": true,
      "failure_code_prefix": "GATE-REF"
    },
    "validate-to-close": {
      "from": "validate",
      "to": "close",
      "authority_profile": {
        "phase": "close",
        "agent_role": "primary",
        "persona_role": "challenge",
        "ontology_role": "contract_enforcement",
        "continuous_execute_supervision": false
      },
      "persona_audit": true,
      "health_scan": "full",
      "trace_audit": true,
      "reachability_audit": true,
      "failure_code_prefix": "GATE-VAL"
    },
    "notify-user": {
      "from": ["close", "validate"],
      "to": null,
      "authority_profile": {
        "phase": "close",
        "agent_role": "primary",
        "persona_role": "challenge",
        "ontology_role": "contract_enforcement",
        "continuous_execute_supervision": false
      },
      "audit_only": true,
      "handoff_only": true,
      "persona_audit": false,
      "health_scan": null,
      "trace_audit": false,
      "reachability_audit": false,
      "failure_code_prefix": "GATE-NTF"
    }
  }
}
