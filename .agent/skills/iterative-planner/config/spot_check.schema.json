{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Iterative Planner Spot Check Config",
  "type": "object",
  "required": ["spot_checks"],
  "properties": {
    "spot_checks": {
      "type": "object",
      "required": [
        "enabled",
        "provider",
        "max_checks_per_plan",
        "max_checks_per_minute",
        "categories",
        "severity_thresholds",
        "file_patterns",
        "cooldown_after_ack",
        "retention_class"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "max_checks_per_plan": { "type": "integer", "minimum": 1 },
        "max_checks_per_minute": { "type": "integer", "minimum": 1 },
        "categories": {
          "type": "object",
          "required": [
            "bug_patterns",
            "left_behind_artifacts",
            "consistency",
            "test_adequacy",
            "incomplete_refactor"
          ],
          "properties": {
            "bug_patterns": { "type": "boolean" },
            "left_behind_artifacts": { "type": "boolean" },
            "consistency": { "type": "boolean" },
            "test_adequacy": { "type": "boolean" },
            "incomplete_refactor": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "severity_thresholds": {
          "type": "object",
          "required": ["hint_count", "interrupt_count", "block_count"],
          "properties": {
            "hint_count": { "type": "integer", "minimum": 1 },
            "interrupt_count": { "type": "integer", "minimum": 1 },
            "block_count": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "file_patterns": {
          "type": "object",
          "required": ["include", "exclude"],
          "properties": {
            "include": { "type": "array", "items": { "type": "string" } },
            "exclude": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "cooldown_after_ack": { "type": "integer", "minimum": 0 },
        "retention_class": { "const": 3 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
