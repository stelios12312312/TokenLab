{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planner.scientific_review_receipt.v1",
  "title": "Deterministic scientific review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_status", "design_validity", "evidence_grade", "scientific_verdict", "promotion_status", "satisfied", "blockers", "warnings", "recomputed", "checks"],
  "properties": {
    "schema_version": { "const": "planner.scientific_review_receipt.v1" },
    "execution_status": { "enum": ["not_run", "complete", "failed"] },
    "design_validity": { "enum": ["valid", "invalid", "unresolved"] },
    "evidence_grade": { "enum": ["evidence", "exploratory", "smoke_fixture", "underpowered", "legacy_unknown"] },
    "scientific_verdict": { "enum": ["supported", "falsified", "inconclusive", "not_evaluated"] },
    "promotion_status": { "enum": ["blocked", "research_only", "candidate_for_confirmation", "eligible_for_integration_review"] },
    "satisfied": { "type": "boolean" },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "recomputed": {
      "oneOf": [
        { "type": "object", "maxProperties": 0 },
        { "$ref": "#/$defs/recomputed" }
      ]
    },
    "checks": {
      "oneOf": [
        { "type": "object", "maxProperties": 0 },
        { "$ref": "#/$defs/checks" }
      ]
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail", "severity"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["blocker", "warning"] }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "start", "end"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_id", "title", "hypothesis_id", "ticket_id", "story_id", "plan_id"],
      "properties": {
        "experiment_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "hypothesis_id": { "type": "string", "minLength": 1 },
        "ticket_id": { "type": "string", "minLength": 1 },
        "story_id": { "type": "string", "minLength": 1 },
        "plan_id": { "type": "string", "minLength": 1 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_folds", "completed_folds", "usable_folds", "requested_trials", "completed_trials", "eligible_assets", "total_observations", "eligible_observations", "excluded_observations", "effective_groups"],
      "properties": {
        "requested_folds": { "type": "integer", "minimum": 0 },
        "completed_folds": { "type": "integer", "minimum": 0 },
        "usable_folds": { "type": "integer", "minimum": 0 },
        "requested_trials": { "type": "integer", "minimum": 0 },
        "completed_trials": { "type": "integer", "minimum": 0 },
        "eligible_assets": { "type": "integer", "minimum": 0 },
        "total_observations": { "type": "integer", "minimum": 0 },
        "eligible_observations": { "type": "integer", "minimum": 0 },
        "excluded_observations": { "type": "integer", "minimum": 0 },
        "effective_groups": { "type": "integer", "minimum": 0 }
      }
    },
    "shortfall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "actual", "required"],
      "properties": {
        "key": { "enum": ["assets", "completed_folds", "completed_trials", "eligible_observations", "effective_groups"] },
        "actual": { "type": "integer", "minimum": 0 },
        "required": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "time_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "issues", "actual_windows", "preregistered_roles", "purge_days"],
      "properties": {
        "valid": { "type": "boolean" },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "actual_windows": { "type": "array", "items": { "$ref": "#/$defs/window" } },
        "preregistered_roles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "purge_days": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "power_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "underpowered", "execution_observed", "issues", "warnings", "counts", "shortfalls"],
      "properties": {
        "valid": { "type": "boolean" },
        "underpowered": { "type": "boolean" },
        "execution_observed": { "type": "boolean" },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "counts": { "$ref": "#/$defs/counts" },
        "shortfalls": { "type": "array", "items": { "$ref": "#/$defs/shortfall" } }
      }
    },
    "parameter_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "exploratory", "issues", "warnings", "dimensions"],
      "properties": {
        "valid": { "type": "boolean" },
        "exploratory": { "type": "boolean" },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "dimensions": { "type": "array", "items": { "enum": ["windows", "frequency", "universe", "strategy_families", "parameter_ranges", "weights", "thresholds", "trials", "folds"] }, "uniqueItems": true }
      }
    },
    "universe_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "exploratory", "issues", "warnings", "actual_asset_ids", "eligible_count", "excluded_count"],
      "properties": {
        "valid": { "type": "boolean" },
        "exploratory": { "type": "boolean" },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "actual_asset_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "eligible_count": { "type": "integer", "minimum": 0 },
        "excluded_count": { "type": "integer", "minimum": 0 }
      }
    },
    "identity_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "issues", "expected_identity"],
      "properties": {
        "valid": { "type": "boolean" },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "expected_identity": { "$ref": "#/$defs/identity" }
      }
    },
    "counterargument_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "exploratory", "issues", "warnings", "types"],
      "properties": {
        "valid": { "type": "boolean" },
        "exploratory": { "type": "boolean" },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "types": { "type": "array", "items": { "enum": ["temporal_leakage", "dependence_power", "parameter_arbitrariness", "universe_bias", "provenance_integrity", "identity_consistency"] }, "uniqueItems": true }
      }
    },
    "provenance_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "smoke_fixture", "fixture_reasons", "issues", "warnings", "canonical_evidence_root", "output_root", "code_revision", "artifact_directory"],
      "properties": {
        "valid": { "type": "boolean" },
        "smoke_fixture": { "type": "boolean" },
        "fixture_reasons": { "type": "array", "items": { "enum": ["test", "synthetic", "short_history", "bypass", "temporary_output", "diagnostic_run_class"] }, "uniqueItems": true },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "canonical_evidence_root": { "type": ["string", "null"] },
        "output_root": { "type": ["string", "null"] },
        "code_revision": { "type": ["string", "null"] },
        "artifact_directory": { "type": "string", "minLength": 1 }
      }
    },
    "recomputed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "actual_assets", "actual_windows", "fixture_reasons", "code_revision", "request_sha256", "artifact_sha256"],
      "properties": {
        "counts": { "$ref": "#/$defs/counts" },
        "actual_assets": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "actual_windows": { "type": "array", "items": { "$ref": "#/$defs/window" } },
        "fixture_reasons": { "type": "array", "items": { "enum": ["test", "synthetic", "short_history", "bypass", "temporary_output", "diagnostic_run_class"] }, "uniqueItems": true },
        "code_revision": { "type": ["string", "null"] },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preregistration": { "$ref": "#/$defs/sha256" },
            "executed_config": { "$ref": "#/$defs/sha256" },
            "universe": { "$ref": "#/$defs/sha256" },
            "folds": { "$ref": "#/$defs/sha256" },
            "trials": { "$ref": "#/$defs/sha256" },
            "observations": { "$ref": "#/$defs/sha256" },
            "result": { "$ref": "#/$defs/sha256" },
            "registry": { "$ref": "#/$defs/sha256" },
            "ticket": { "$ref": "#/$defs/sha256" },
            "plan_identity": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "power", "parameters", "universe", "identity", "counterarguments", "provenance"],
      "properties": {
        "time": { "$ref": "#/$defs/time_check" },
        "power": { "$ref": "#/$defs/power_check" },
        "parameters": { "$ref": "#/$defs/parameter_check" },
        "universe": { "$ref": "#/$defs/universe_check" },
        "identity": { "$ref": "#/$defs/identity_check" },
        "counterarguments": { "$ref": "#/$defs/counterargument_check" },
        "provenance": { "$ref": "#/$defs/provenance_check" }
      }
    }
  }
}
