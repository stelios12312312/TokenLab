{
  "schema_version": 1,
  "obligations": [
    {
      "id": "APPDEV-OBL-ASYNC-STATES",
      "title": "Async loading, error, and empty state proof",
      "subject_id": "pack_app_dev_async_states",
      "mode": "artifact_review",
      "severity": "required",
      "required_by_phase": "plan",
      "applies_when": {
        "text_any": [
          "fetch(",
          "axios",
          "api call",
          "async request"
        ]
      },
      "satisfied_by": {
        "any": [
          {
            "id": "async_state_validation_ref",
            "kind": "validation_ref_terms_any",
            "terms": [
              "loading state",
              "error state",
              "empty state"
            ]
          },
          {
            "id": "async_state_artifact",
            "kind": "artifact_exists_any",
            "paths": [
              "reports/app-dev/async-states.json",
              "reports/app-dev/rendered-journey.json"
            ]
          }
        ]
      }
    },
